<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>org.seamless-failover.netfailoverd</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/netfailoverd</string>
    <string>--config</string>
    <string>/usr/local/etc/netfailover.conf</string>
  </array>
  <key>KeepAlive</key>
  <true/>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/var/log/netfailover.log</string>
  <key>StandardErrorPath</key>
  <string>/var/log/netfailover.log</string>
</dict>
</plist>
